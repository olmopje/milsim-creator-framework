// A board in the world with the game's own map on it.
//
// THE MESH IS VANILLA'S RANGE TABLE, on purpose and for now. Its material
// already samples $rendertarget -- it is what the ballistic table draws its
// pages onto -- so this proves the picture lands without a line of material
// authoring. Frames of our own (a paper map on a table, a whiteboard, a
// beamer board) each need their own mesh and their own material, and that is
// the next piece of work rather than this one.
GenericEntity {
 ID "6A1C4F0B39E12001"
 components {
  MeshObject "{6A1C4F0B39E12002}" {
   Object "{35054A71A764B615}Assets/Items/Misc/BallisticTable/RangeTable_01.xob"
  }
  RigidBody "{6A1C4F0B39E12003}" {
   Enabled 1
   LinearDamping 0.5
   AngularDamping 0.5
   ModelGeometry 1
  }
  MCF_Map_BoardComponent "{6A1C4F0B39E12004}" {
  }
  SCR_EditableEntityComponent "{6A1C4F0B39E12005}" : "{996046FE206C699A}Prefabs/Editor/Components/Default_SCR_EditableEntityComponent.ct" {
   m_EntityType OBJECT
   m_UIInfo SCR_EditableEntityUIInfo "{6A1C4F0B39E12006}" {
    Name "MCF Map: board"
    Description "A board showing this world's own map. Place it, and it draws whatever terrain the mission is on."
    m_aAuthoredLabels {
     ENTITYTYPE_OBJECT
     CONTENT_MODDED
    }
   }
  }
 }
}
