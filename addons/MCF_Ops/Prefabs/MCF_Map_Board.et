// A board in the world with the game's own map on it.
//
// THE MESH IS ITS OWN: a flat panel in a thin frame, built by
// tools/make_map_board.py, one metre wide and 10:7. Two material slots --
// MapBoard_Surface samples $rendertarget and is the map, MapBoard_Frame is
// the border -- and a UBX_ box collider so the thing can be stood in front of.
//
// SCALE IT. A Game Master resizes this like any other object, which is how it
// goes from something on a table to something covering a wall.
GenericEntity {
 ID "6A1C4F0B39E12001"
 components {
  MeshObject "{6A1C4F0B39E12002}" {
   Object "{6A1C4F0B39E13000}Assets/Props/Intel/MapBoard/MapBoard.xob"
  }
  RplComponent "{6A1C4F0B39E12007}" {
  }
  RigidBody "{6A1C4F0B39E12003}" {
   Enabled 1
   LinearDamping 0.5
   AngularDamping 0.5
   ModelGeometry 1
  }
  MCF_Map_BoardComponent "{6A1C4F0B39E12004}" {
  }
  SCR_EditableEntityComponent "{6A1C4F0B39E12005}" : "{996046FE206C699A}Prefabs/Editor/Components/Default_SCR_EditableEntityComponent.ct" {
   m_EntityType OBJECT
   m_UIInfo SCR_EditableEntityUIInfo "{6A1C4F0B39E12006}" {
    Name "MCF Map: board"
    Description "A board showing this world's own map. Place it, and it draws whatever terrain the mission is on."
    m_aAuthoredLabels {
     ENTITYTYPE_OBJECT
     CONTENT_MODDED
    }
   }
  }
 }
}
