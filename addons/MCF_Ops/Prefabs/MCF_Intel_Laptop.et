GenericEntity : "{C95E11C60810F432}Prefabs/Items/Core/Item_Base.et" {
 ID "6A1C4F0B39D2D060"
 components {
  InventoryItemComponent "{5222EB4D0C73006B}" {
   Attributes SCR_ItemAttributeCollection "{5222EB4D0A2B466B}" {
    ItemDisplayName UIInfo "{5222EB4D07D865FA}" {
     Name "Laptop"
    }
    ItemPhysAttributes ItemPhysicalAttributes PhysicalAttributes {
     Weight 0.15
     SizeSetupStrategy Manual
     // INVENTORY CELLS, NOT CENTIMETRES. These are grid squares: vanilla's
     // medical kit is 2 2 2 with a volume of 2, which is a 2x2 item -- the same
     // footprint m_Size already declares. Written as real centimetres,
     // 36 25 3 with a volume of 2700, this was larger than any container a
     // player carries and pick-up was refused with nothing said about why.
     ItemDimensions 1 1 1
     ItemVolume 1
     DimensionScaler 1
    }
    // THE INVENTORY THUMBNAIL IS A LIVE RENDER, not an image file. Without
    // PreviewRenderAttributes the camera uses defaults meant for a small item
    // held upright, and a wide flat object ends up cropped or edge-on.
    //
    // CameraOrbitAngles is PITCH, yaw, roll -- established by elimination on
    // the phone, not from documentation. 55 degrees looks down at the closed
    // lid from the front, which reads as a laptop rather than as a grey slab.
    CustomAttributes {
     PreviewRenderAttributes "{6A1C4F0B39D2D0A0}" {
      CameraOrbitAngles 55 0 0
      CameraDistanceToItem 0.62
      ItemRenderRotation 0 0 0
      LodModel 1
     }
    }
    m_Size SLOT_1x1
    m_SlotType SLOT_LOADOUT_STORAGE
   }
  }
  MCF_Intel_CarrierComponent "{6A1C4F0B39D2D033}" {
   m_sDeviceName "Field laptop"
   m_eView LAPTOP
   m_sActionVerb "Use"
   m_sPreviewPrefab "{6A1C4F0B39D2D090}Prefabs/MCF_Intel_Laptop_Preview.et"
   m_sProfileId "field_laptop"
   m_aEntries {
    MCF_Intel_Entry "{6A1C4F0B39D2D034}" {
     m_sHeading "Consignment manifest"
     m_sTimestamp "12 MAR"
     m_sBody "Four crates, marked as agricultural machinery. Weights do not match the paperwork. Signed for at the mill by somebody whose name is not on the roster."
    }
    MCF_Intel_Entry "{6A1C4F0B39D2D035}" {
     m_sHeading "Route sheet"
     m_sTimestamp "13 MAR"
     m_sBody "River road after dark, no lights past the bridge. Second driver waits at the quarry and takes it from there."
    }
   }
   m_vPreviewSize 0.36 0.351 0.227
  }
  MeshObject "{6A1C4F0B39D2D031}" {
   Object "{45F5FEABF5F2BF90}Assets/Props/Intel/Laptop/Laptop_Body.xob"
  }
  RigidBody "{6A1C4F0B39D2D032}" {
   Mass 0.15
   LinearDamping 0.5
   AngularDamping 0.5
   ModelGeometry 1
  }
  // The lid is a child ENTITY, and a stored item only hides itself -- see
  // MCF_Devices_StowChildrenComponent.c. Without this the lid stayed drawn at
  // the carrier's origin and floated around the player's feet.
  MCF_Devices_StowChildrenComponent "{6A1C4F0B39D2D0B0}" {
  }
  MCF_Devices_LockComponent "{6A1C4F0B39D2D070}" {
   m_bSecured 1
   m_iDifficulty 2
   m_sBreakInVerb "Break in"
  }
  SCR_EditableEntityComponent "{6A1C4F0B39D2D03A}" : "{996046FE206C699A}Prefabs/Editor/Components/Default_SCR_EditableEntityComponent.ct" {
   m_EntityType GENERIC
   m_UIInfo SCR_EditableEntityUIInfo "{6A1C4F0B39D2D03B}" {
    Name "MCF Intel: Laptop"
    m_aAuthoredLabels {
     ENTITYTYPE_OBJECT CONTENT_MODDED
    }
   }
  }
  ActionsManagerComponent "{508AB5952B584B2E}" {
   ActionContexts {
    // A LAPTOP IS 36cm ACROSS. The context inherited from Item_Base is a 20cm
    // sphere around the entity origin, which is generous for an envelope and
    // leaves most of a laptop outside it -- aim at either end and there is no
    // prompt at all. Widened to cover the object it is actually on.
    UserActionContext "{508AC2ABEC97066C}" {
     Radius 0.35
    }
   }
   additionalActions {
    MCF_Intel_ReadAction "{6A1C4F0B39D2D038}" {
     ParentContextList {
      "default"
     }
     UIInfo UIInfo "{6A1C4F0B39D2D039}" {
      Name "Use"
     }
     VisibilityRange 3
     Duration 2
    }
   }
  }
 }
