// A phone you have to break into before you can read it.
//
// The mesh is the imported smartphone, 878 tris, 7.0 x 14.9 x 0.9 cm, with its
// collision coming from the model's own UTM_ box via ModelGeometry below.
//
// HOW IT IS FRAMED IN THE SHELL. PreviewRenderAttributes, under the inventory
// attribute collection, is what the vanilla inventory uses to decide how an
// item is posed in its 3D preview -- Jerrycan_01_item_base.et is the worked
// example. MCF_Intel_ShellMenu renders this prefab through the same system.
//
// The model lies flat, which is right for a phone on a table and wrong for one
// held up to your face: the preview camera looks at it horizontally and sees a
// thin edge. So the camera is lifted over it instead of the model being stood
// up -- the model's orientation is what the world uses, and nothing about a UI
// screen should reach back and change that.
//
// CameraOrbitAngles is PITCH, yaw, roll in degrees, in that order -- established
// by elimination against the screen, not from documentation, and written down
// because two plausible readings of it are wrong.
//
//   middle slot at 90   nothing changed at all
//   last slot at 90     the thin edge went from horizontal to vertical, which
//                       is a roll and nothing else
//
// That leaves the first slot as the elevation. Reasoning from the vanilla
// jerrycan's 0 15 15 suggested otherwise and was simply wrong; the screen wins.
//
// 90 of pitch lifts the camera overhead and looks down at the face. The yaw
// then decides whether the phone reads portrait or landscape.
//
// CameraDistanceToItem is what sets the phone's SIZE on screen, not the widget
// it is drawn into: the camera fits the model and the result is then placed
// inside whatever box the layout gives it. At 0.22 the phone came out 116 x 255
// pixels in a 1920x1080 viewport, measured off a screenshot. 0.074 is that
// scaled to roughly 357 x 760, which is the size MCF_IntelDevice.layout's
// SCREEN_RECT is cut for -- the two numbers have to move together.
//
// WHAT MAKES IT A DEVICE. Three components, from two different addons:
//
//   MCF_Intel_CarrierComponent   Ops       what it knows
//   MCF_Devices_LockComponent    Devices   whether you may look
//   RplComponent                 vanilla   so the server can be told which one
//                                        -- inherited from Item_Base, NOT
//                                        declared here: a second one would
//                                        replicate nothing and the lock would
//                                        never reach a client.
//
// The actions manager below overrides Item_Base's own by GUID rather than
// adding a second component. Declaring a fresh one leaves two managers on the
// entity and the interaction system only looks at one of them, so the prompt
// silently never appears.
//
// Two actions that are never both visible: the break-in prompt while it is
// locked, and Ops' plain read prompt afterwards. MCF_Devices_ReadGate.c is what
// hides the second one, and it lives in the Devices module, so removing that
// module leaves a phone that simply reads -- see the note in
// MCF_Devices_LockComponent.c about why unlocked is the right way to fail.
GenericEntity : "{C95E11C60810F432}Prefabs/Items/Core/Item_Base.et" {
 ID "6A1C4F0B39D30100"
 components {
  MeshObject "{6A1C4F0B39D30101}" {
   Object "{F8CCF67BB2B3ADF4}Assets/Props/Devices/Smartphone/Smartphone.xob"
  }
  RigidBody "{6A1C4F0B39D30102}" {
   Mass 0.2
   LinearDamping 0.5
   AngularDamping 0.5
   ModelGeometry 1
  }
  InventoryItemComponent "{5222EB4D0C73006B}" {
   Attributes SCR_ItemAttributeCollection "{5222EB4D0A2B466B}" {
    ItemDisplayName UIInfo "{5222EB4D07D865FA}" {
     Name "Mobile phone"
    }
    ItemPhysAttributes ItemPhysicalAttributes PhysicalAttributes {
     Weight 0.15
     SizeSetupStrategy Manual
     // Inventory cells, not centimetres. A 1x1 item is 1 1 1 with a volume
     // of 1, which is what m_Size SLOT_1x1 below already says it is.
     ItemDimensions 1 1 1
     ItemVolume 1
     DimensionScaler 1
    }
    CustomAttributes {
     PreviewRenderAttributes "{6A1C4F0B39D30113}" {
      CameraOrbitAngles 90 0 0
      CameraDistanceToItem 0.16
      ItemRenderRotation 0 0 0
      LodModel 1
     }
    }
    m_Size SLOT_1x1
    m_SlotType SLOT_LOADOUT_STORAGE
   }
  }
  MCF_Intel_CarrierComponent "{6A1C4F0B39D30106}" {
   m_sDeviceName "Mobile phone"
   m_eView PHONE
   m_sProfileId "smuggler_phone"
   m_sPreviewPrefab "{6A1C4F0B39D30100}Prefabs/MCF_Devices_Phone.et"
   m_sActionVerb "Search"
   m_aEntries {
    MCF_Intel_Entry "{6A1C4F0B39D30107}" {
     m_sHeading "M. - 02:14"
     m_sTimestamp "14 MAR"
     m_sBody "Truck is loaded. We move at first light, not before. Tell your cousin to keep the dogs in."
     m_eApp MESSAGES
    }
    MCF_Intel_Entry "{6A1C4F0B39D30108}" {
     m_sHeading "Unknown number - 09:40"
     m_sTimestamp "15 MAR"
     m_sBody "Do not use this number again. The mill is watched."
     m_eApp MESSAGES
    }
    MCF_Intel_Entry "{6A1C4F0B39D30109}" {
     m_sHeading "Draft, not sent"
     m_sTimestamp "15 MAR"
     m_sBody "If anything happens to me the papers are behind the stove at my mother's."
     m_eApp NOTES
    }
    MCF_Intel_Entry "{6A1C4F0B39D30114}" {
     m_sHeading "Outgoing - 0412"
     m_sTimestamp "15 MAR"
     m_sBody "M. - 4 min 12 s. Third call to this number today."
     m_eApp CALLS
    }
    MCF_Intel_Entry "{6A1C4F0B39D30115}" {
     m_sHeading "Missed - 0455"
     m_sTimestamp "15 MAR"
     m_sBody "Unknown number. No voicemail."
     m_eApp CALLS
    }
    MCF_Intel_Entry "{6A1C4F0B39D30116}" {
     m_sHeading "Incoming - 2140"
     m_sTimestamp "14 MAR"
     m_sBody "The mill - 47 s."
     m_eApp CALLS
    }
    MCF_Intel_Entry "{6A1C4F0B39D30117}" {
     m_sHeading "M."
     m_sBody "Saved under one letter and nothing else. Called more than anyone."
     m_eApp CONTACTS
    }
    MCF_Intel_Entry "{6A1C4F0B39D30118}" {
     m_sHeading "The mill"
     m_sBody "A landline. Same number as the one warned about in messages."
     m_eApp CONTACTS
    }
    MCF_Intel_Entry "{6A1C4F0B39D30119}" {
     m_sHeading "Mother"
     m_sBody "Not called since the fourth."
     m_eApp CONTACTS
    }
    MCF_Intel_Entry "{6A1C4F0B39D3011A}" {
     m_sHeading "Wi-Fi"
     m_sBody "Joined: MILL-OFFICE. Saved, connects automatically."
     m_eApp SETTINGS
    }
    MCF_Intel_Entry "{6A1C4F0B39D3011B}" {
     m_sHeading "Account"
     m_sBody "Signed in as k.varga. Backup last ran 11 MAR."
     m_eApp SETTINGS
    }
   }
  }
  MCF_Devices_LockComponent "{6A1C4F0B39D3010A}" {
   m_bSecured 1
   m_iDifficulty 2
   m_sBreakInVerb "Break into"
  }
  ActionsManagerComponent "{508AB5952B584B2E}" {
   additionalActions +{
    MCF_Intel_ReadAction "{6A1C4F0B39D3010F}" {
     ParentContextList {
      "default"
     }
     UIInfo UIInfo "{6A1C4F0B39D30110}" {
      Name "Search"
     }
     VisibilityRange 3
     Duration 2
    }
   }
  }
  SCR_EditableEntityComponent "{6A1C4F0B39D30111}" : "{996046FE206C699A}Prefabs/Editor/Components/Default_SCR_EditableEntityComponent.ct" {
   m_EntityType OBJECT
   m_UIInfo SCR_EditableEntityUIInfo "{6A1C4F0B39D30112}" {
    Name "MCF Device: Phone (secured)"
    m_aAuthoredLabels {
     ENTITYTYPE_OBJECT
     CONTENT_MODDED
    }
   }
  }
 }
}
