FrameWidgetClass {
 Name "rootFrame"
 {
  ImageWidgetClass "{6A1C4F0B39E10001}" {
   Name "Dim"
   Slot FrameWidgetSlot "{6A1C4F0B39E10002}" {
    Anchor 0 0 1 1
    PositionX 0
    OffsetLeft 0
    PositionY 0
    OffsetTop 0
    SizeX 0
    OffsetRight 0
    SizeY 0
    OffsetBottom 0
   }
   Color 0 0 0 0.85
  }

  // ---- TEST A: the map in a widget of ours, at a position we chose.
  //
  // THE SLOTS HERE COPY MapMini.layout EXACTLY and deliberately. The first
  // attempt used `Anchor` with a size, and every widget came out 0 x 0 -- and
  // a render target asked for a texture of zero size, which is the flood of
  // "Out of memory when requested 0, Type: Video" in that log. Vanilla's own
  // minimap positions a MapWidget with no Anchor at all: position, size, and
  // the two offsets as the negative of position+size.
  MapWidgetClass "{0000000060029FBB}" {
   Name "MapWidget"
   Slot FrameWidgetSlot "{6A1C4F0B39E10005}" {
    PositionX 80
    OffsetLeft 80
    PositionY 140
    OffsetTop 140
    SizeX 640
    OffsetRight -720
    SizeY 420
    OffsetBottom -560
   }
   Color 1 1 1 1
   SizeInUnits 1024 1024
   OffsetPixels 0 0
   Clear 1
   ClearColor 0.173 0.344 0.62 1
  }

  TextWidgetClass "{6A1C4F0B39E1000A}" {
   Name "LabelA"
   Slot FrameWidgetSlot "{6A1C4F0B39E1000B}" {
    PositionX 80
    OffsetLeft 80
    PositionY 105
    OffsetTop 105
    SizeX 640
    OffsetRight -720
    SizeY 28
    OffsetBottom -133
   }
   Text "A  the map in a widget of ours"
   "Font Size" 16
   "Min Font Size" 16
  }

  // ---- TEST B: the same widget, inside a render target.
  //
  // A render target draws no picture until a material samples it, so this
  // half cannot show terrain. What it reports is whether the map widget
  // inside one is laid out at all: PixelPerUnit at or below zero means it is
  // not, and no board can work this way.
  RTTextureWidgetClass "{6A1C4F0B39E1000C}" {
   Name "Probe"
   Slot FrameWidgetSlot "{6A1C4F0B39E1000D}" {
    PositionX 800
    OffsetLeft 800
    PositionY 140
    OffsetTop 140
    SizeX 640
    OffsetRight -1440
    SizeY 420
    OffsetBottom -560
   }
   {
    MapWidgetClass "{0000000060029FBB}" {
     Name "ProbeMapWidget"
     Slot FrameWidgetSlot "{6A1C4F0B39E10010}" {
      PositionX 0
      OffsetLeft 0
      PositionY 0
      OffsetTop 0
      SizeX 640
      OffsetRight -640
      SizeY 420
      OffsetBottom -420
     }
     Color 1 1 1 1
     SizeInUnits 1024 1024
     OffsetPixels 0 0
     Clear 1
     ClearColor 0.62 0.344 0.173 1
    }
   }
  }

  TextWidgetClass "{6A1C4F0B39E10011}" {
   Name "LabelB"
   Slot FrameWidgetSlot "{6A1C4F0B39E10012}" {
    PositionX 800
    OffsetLeft 800
    PositionY 105
    OffsetTop 105
    SizeX 640
    OffsetRight -1440
    SizeY 28
    OffsetBottom -133
   }
   Text "B  the same, inside a render target"
   "Font Size" 16
   "Min Font Size" 16
  }

  RichTextWidgetClass "{6A1C4F0B39E10013}" {
   Name "Report"
   Slot FrameWidgetSlot "{6A1C4F0B39E10014}" {
    PositionX 80
    OffsetLeft 80
    PositionY 600
    OffsetTop 600
    SizeX 1360
    OffsetRight -1440
    SizeY 380
    OffsetBottom -980
   }
   Clipping Ancestor
   Wrap 1
   Text ""
   "Font Size" 14
   "Min Font Size" 14
   "Line Spacing" 20
  }

  ButtonWidgetClass "{6A1C4F0B39E10015}" : "{6A1C4F0B39D2B000}UI/layouts/MCF/MCF_PlanningBoard_TaskEntry.layout" {
   Name "ButtonClose"
   Slot FrameWidgetSlot "{6A1C4F0B39E10016}" {
    PositionX 1300
    OffsetLeft 1300
    PositionY 30
    OffsetTop 30
    SizeX 140
    OffsetRight -1440
