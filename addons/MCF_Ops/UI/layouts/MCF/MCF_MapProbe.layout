FrameWidgetClass {
 Name "rootFrame"
 {
  ImageWidgetClass "{6A1C4F0B39E10001}" {
   Name "Dim"
   Slot FrameWidgetSlot "{6A1C4F0B39E10002}" {
    Anchor 0 0 1 1
    PositionX 0
    OffsetLeft 0
    PositionY 0
    OffsetTop 0
    SizeX 0
    OffsetRight 0
    SizeY 0
    OffsetBottom 0
   }
   Color 0 0 0 0.85
  }

  // ---- TWO HOSTS, EACH WITH ITS OWN "MapWidget".
  //
  // OpenMap does FindAnyWidget("MapWidget") on whatever root it is given, so
  // handing it one host or the other decides which of these the map binds to.
  // That is the whole of stage two: the same map, once in a plain widget and
  // once inside a render target, and the numbers say which one it drove.
  //
  // The slots copy MapMini.layout exactly -- no Anchor, position and size,
  // offsets as the negative of position+size. Anchor plus a size gives 0 x 0,
  // and a render target sized zero asks for a texture sized zero, which is a
  // wall of "Out of memory when requested 0, Type: Video".
  FrameWidgetClass "{6A1C4F0B39E10003}" {
   Name "PlainHost"
   Slot FrameWidgetSlot "{6A1C4F0B39E10004}" {
    PositionX 80
    OffsetLeft 80
    PositionY 140
    OffsetTop 140
    SizeX 640
    OffsetRight -720
    SizeY 420
    OffsetBottom -560
   }
   {
    MapWidgetClass "{0000000060029FBB}" {
     Name "MapWidget"
     Slot FrameWidgetSlot "{6A1C4F0B39E10005}" {
      PositionX 0
      OffsetLeft 0
      PositionY 0
      OffsetTop 0
      SizeX 640
      OffsetRight -640
      SizeY 420
      OffsetBottom -420
     }
     Color 1 1 1 1
     SizeInUnits 1024 1024
     OffsetPixels 0 0
     Clear 1
     ClearColor 0.173 0.344 0.62 1
    }
   }
  }

  TextWidgetClass "{6A1C4F0B39E1000A}" {
   Name "LabelA"
   Slot FrameWidgetSlot "{6A1C4F0B39E1000B}" {
    PositionX 80
    OffsetLeft 80
    PositionY 105
    OffsetTop 105
    SizeX 640
    OffsetRight -720
    SizeY 28
    OffsetBottom -133
   }
   Text "A  plain widget"
   "Font Size" 16
   "Min Font Size" 16
  }

  RTTextureWidgetClass "{6A1C4F0B39E1000C}" {
   Name "Probe"
   Slot FrameWidgetSlot "{6A1C4F0B39E1000D}" {
    PositionX 800
    OffsetLeft 800
    PositionY 140
    OffsetTop 140
    SizeX 640
    OffsetRight -1440
    SizeY 420
    OffsetBottom -560
   }
   {
    MapWidgetClass "{0000000060029FBB}" {
     Name "MapWidget"
     Slot FrameWidgetSlot "{6A1C4F0B39E10010}" {
      PositionX 0
      OffsetLeft 0
      PositionY 0
      OffsetTop 0
      SizeX 640
      OffsetRight -640
      SizeY 420
      OffsetBottom -420
     }
     Color 1 1 1 1
     SizeInUnits 1024 1024
     OffsetPixels 0 0
     Clear 1
     ClearColor 0.62 0.344 0.173 1
    }
   }
  }

  TextWidgetClass "{6A1C4F0B39E10011}" {
   Name "LabelB"
   Slot FrameWidgetSlot "{6A1C4F0B39E10012}" {
    PositionX 800
    OffsetLeft 800
    PositionY 105
