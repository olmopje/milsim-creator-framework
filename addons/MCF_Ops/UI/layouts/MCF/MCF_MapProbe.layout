      SizeY 0
      OffsetBottom 0
     }
     Color 1 1 1 1
     SizeInUnits 1024 1024
     OffsetPixels 0 0
     Clear 1
     ClearColor 0.173 0.344 0.62 1
    }
    CanvasWidgetClass "{6A1C4F0B39E10006}" {
