// DIAGNOSTIC ONLY, and it exists to answer one question.
//
// The board draws its clear colour and no map. The obvious next test --
// hang the board's own tree on the screen -- cannot answer anything,
// because the thing in that tree is the RTTextureWidget, and an
// RTTextureWidget sends its subtree to the entity's mesh rather than to the
// screen. Put it on the screen and you see nothing, which is what happened.
//
// So this is the SAME map widget with NO render target around it. Open the
// map into this and look:
//
//   map appears  -> the map draws fine, and a render target is what cannot
//                   catch it. The board needs another route.
//   still blue   -> the map is not drawing anywhere, and the fault is in the
//                   MapConfiguration we build by hand.
//
// Delete this file once that is written down.
FrameWidgetClass {
 Name "rootFrame"
 Slot FrameWidgetSlot "{6A1C4F0B39E11011}" {
  SizeX 1024
  OffsetRight -1024
  SizeY 700
  OffsetBottom -700
 }
 {
  MapWidgetClass "{0000000060029FBB}" {
   Name "MapWidget"
   Slot FrameWidgetSlot "{6A1C4F0B39E11013}" {
    PositionX 0
    OffsetLeft 0
    PositionY 0
    OffsetTop 0
    SizeX 1024
    OffsetRight -1024
    SizeY 700
    OffsetBottom -700
   }
   Color 1 1 1 1
   SizeInUnits 1024 700
   OffsetPixels 0 0
   Clear 1
   ClearColor 0.173 0.344 0.62 1
  }
 }
}
