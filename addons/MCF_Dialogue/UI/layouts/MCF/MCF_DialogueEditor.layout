  TextWidgetClass "{6A1C4F0B39D2F153}" {
   Name "Hint"
   Slot FrameWidgetSlot "{6A1C4F0B39D2F154}" {
    Anchor 0.08 0.785 0.92 0.83
    PositionX 0
    OffsetLeft 0
    PositionY 0
    OffsetTop 0
    SizeX 0
    OffsetRight 0
    SizeY 0
    OffsetBottom 0
   }
   Text "No LEADS TO ends the conversation. FIRES EVENT is how a reply causes something. REMEMBERS names what this reply proves; ONLY AFTER requires that name, so a question can open up once they have admitted something."
   "Font Size" 13
   "Min Font Size" 13
  }
 }
}
