// What gets drawn onto a map board in the world.
//
// NEVER PARENTED TO THE SCREEN. The component creates this with
// CreateWidgets(layout) and no parent, so it lives outside the screen
// hierarchy and is only ever seen through the board's material sampling
// $rendertarget. That is how vanilla's ballistic table puts a page on a
// surface, and the shape here is copied from its
// UI/layouts/Gadgets/BallisticTable/BallisticTableRenderTarget.layout.
//
// 1024 x 700, AND THAT IS THE MESH'S NUMBER, NOT A ROUND ONE. The board's
// face is a plane with a default 0..1 unwrap, so the texture is STRETCHED
// across it -- it is not cropped, and nothing about the frame saves a square
// picture from a rectangular face. The face is (1.00 - 2 x 0.025) wide by
// (0.70 - 2 x 0.025) tall = 0.95 x 0.65 m, which is 1.4615 : 1, and
// 1024 / 1.4615 = 700. Texture aspect equals face aspect equals no
// distortion. Change WIDTH, HEIGHT or FRAME in tools/make_map_board.py and
// this number has to move with them.
//
// THE SEA IS THE LETTERBOX. Zoomed all the way out the map fits its height,
// so a square island leaves a margin left and right -- and ClearColor below
// is the map's own sea blue, so that margin reads as water on a wide sheet
// rather than as black bars on a broken screen.
//
// The slots deliberately carry no Anchor. Anchor plus a size gives 0 x 0, and
// a render target sized zero asks the driver for a texture sized zero -- which
// reads in the log as "Out of memory when requested 0, Type: Video" and is a
// layout fault wearing a graphics fault's coat.
FrameWidgetClass {
 Name "rootFrame"
 Slot FrameWidgetSlot "{6A1C4F0B39E11001}" {
  SizeX 1024
  OffsetRight -1024
  SizeY 700
  OffsetBottom -700
 }
 {
  RTTextureWidgetClass "{6A1C4F0B39E11002}" {
   Name "RTTexture0"
   Slot FrameWidgetSlot "{6A1C4F0B39E11003}" {
    PositionX 0
    OffsetLeft 0
    PositionY 0
    OffsetTop 0
    SizeX 1024
    OffsetRight -1024
    SizeY 700
    OffsetBottom -700
   }
   {
    MapWidgetClass "{0000000060029FBB}" {
     Name "MapWidget"
     Slot FrameWidgetSlot "{6A1C4F0B39E11004}" {
      PositionX 0
      OffsetLeft 0
      PositionY 0
      OffsetTop 0
      SizeX 1024
      OffsetRight -1024
      SizeY 700
      OffsetBottom -700
     }
     Color 1 1 1 1
     SizeInUnits 1024 700
     OffsetPixels 0 0
     Clear 1
     ClearColor 0.173 0.344 0.62 1
    }
    // EVERYTHING THE ENGINE DOES NOT DRAW FOR US GOES HERE. A MapWidget is a
    // CanvasWidget, and a CanvasWidget takes draw commands -- lines, images,
    // text -- so markers, labels and, later, freeform strokes are an array we
    // hand over rather than a widget per item.
    //
    // It sits between the map and the whiteout: over the terrain, under the
    // fade, so walking away takes the markers with it.
    //
    // Ours alone. Nothing outside this board's tree can reach it, which is
    // exactly why the markers on it are not at the mercy of whatever a player
    // is doing with their own map.
    CanvasWidgetClass "{6A1C4F0B39E11020}" {
     Name "Overlay"
     Slot FrameWidgetSlot "{6A1C4F0B39E11021}" {
      PositionX 0
      OffsetLeft 0
      PositionY 0
      OffsetTop 0
      SizeX 1024
      OffsetRight -1024
      SizeY 700
      OffsetBottom -700
     }
     Color 1 1 1 1
    }
    // THE FADE, AND IT IS A SHEET OF WHITE OVER THE MAP rather than anything
    // done to the map itself. A map has no opacity of its own to turn down,
    // and dimming the board's material would dim the frame with it. This is
    // a plain white panel, last in the tree so it draws on top, and the
    // component walks its opacity from 0 to 1 as the viewer walks away.
    //
    // At 1 the board reads as a blank white board -- which is exactly what
    // it should look like from across a field.
    ImageWidgetClass "{6A1C4F0B39E11005}" {
     Name "Whiteout"
     Slot FrameWidgetSlot "{6A1C4F0B39E11006}" {
      PositionX 0
      OffsetLeft 0
      PositionY 0
      OffsetTop 0
      SizeX 1024
      OffsetRight -1024
      SizeY 700
      OffsetBottom -700
     }
     Color 1 1 1 1
     Opacity 0
    }
   }
  }
 }
}
