// A key on the passcode pad: the phone button with a circle behind it: a rounded fill that lifts on hover, and
// nothing else. No orange, no border, no 18pt.
//
// It replaces MCF_PlanningBoard_TaskEntry everywhere a control sits on a
// device screen -- the break-in keys, the puzzle controls, the unlock button.
// That row was built for the operations board: 18pt text, a hard orange
// selected state and Clipping False, which on a 250-pixel-wide handset reads
// as a menu bolted onto a phone.
//
// The rounded corners come from the same tile texture the app icons use, so
// every corner radius on the device is one file.
ButtonWidgetClass {
 Name "Button"
 Slot LayoutSlot "{6A1C4F0B39D35141}" {
  Padding 0 0 0 0
  SizeMode Fill
 }
 Clipping True
 components {
  SCR_ButtonTextComponent "{6A1C4F0B39D35142}" {
   m_bCanBeToggled 1
   m_BackgroundDefault 1 1 1 0.10
   m_BackgroundHovered 1 1 1 0.22
   m_BackgroundSelected 0.76 0.39 0.08 0.85
   m_BackgroundSelectedHovered 0.90 0.54 0.18 0.9
   m_BackgroundClicked 1 1 1 0.34
   m_sText ""
  }
 }
 style blank
 {
  OverlayWidgetClass "{6A1C4F0B39D35143}" {
   Name "Overlay"
   Slot ButtonWidgetSlot "{6A1C4F0B39D35144}" {
    HorizontalAlign 3
    VerticalAlign 3
    Padding 0 0 0 0
   }
   {
    ImageWidgetClass "{6A1C4F0B39D35145}" {
     Name "Background"
     Slot OverlayWidgetSlot "{6A1C4F0B39D35146}" {
      HorizontalAlign 3
      VerticalAlign 3
     }
     Texture "{6A1C4F0B39D3520B}UI/images/MCF_Phone/circle.edds"
     Image ""
    }
    TextWidgetClass "{6A1C4F0B39D35147}" {
     Name "Text"
     Slot OverlayWidgetSlot "{6A1C4F0B39D35148}" {
      HorizontalAlign 1
      VerticalAlign 1
      Padding 6 3 6 3
     }
     Text ""
     "Font Size" 17
     "Min Font Size" 17
    }
   }
  }
 }
}
