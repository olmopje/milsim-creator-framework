# Workbench / Enfusion build and cache artefacts
*.bin
*.c.bak
*.rdb
/cache/
/build/
/.workbench/

# Temporary enfusion-mcp .NET API handler scripts. The tool copies these into
# the addon itself to drive the Workbench; they do not belong in git and must
# be removed before publishing via wb_cleanup.
# Any addon, not just MCF -- the tool copies them into whichever one you point
# it at, and naming them one by one means the next addon leaks them into a
# commit before anybody notices.
addons/*/Scripts/WorkbenchGame/
addons/*/EnfusionMCP/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.bak
.vscode/
.idea/

# Local configuration that differs per contributor
config.local.json

enfusion-workbench-mcp/

# Local dedicated-server setup: the launcher config carries machine-specific
# addresses and an admin password, and the profile folder is pure runtime
# output (logs, saves). Neither belongs in the repository.
server/

# Local working copy of the GitHub wiki, which is its own repository.
# Cloned here so the wiki can be edited alongside the code; it is never part
# of this repository's history.
.wiki/
